{
  "name": "glove-env-notion",
  "version": "0.1.0",
  "description": "Notion stdlib adapter for glove-working-environment. Mounts a workspace as env:notion — pages read as markdown, database rows as flat records, files pulled into the tree. Speaks API version 2025-09-03, so databases and data sources are separate objects.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/porkytheblack/glove.git",
    "directory": "packages/glove-env-notion"
  },
  "homepage": "https://github.com/porkytheblack/glove",
  "bugs": "https://github.com/porkytheblack/glove/issues",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "peerDependencies": {
    "glove-working-environment": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "glove-working-environment": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
