{
  "name": "glove-execution",
  "version": "0.1.0",
  "description": "Mounted browser scripting and persistent sandbox capabilities for Glove agents, with Station backends",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/porkytheblack/glove.git", "directory": "packages/glove-execution" },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
