  "files": ["dist", "README.md"],
  "scripts": { "build": "tsup", "typecheck": "tsc --noEmit", "test": "node --test --import tsx tests/*.test.ts" },
  "dependencies": { "glove-core": "workspace:*", "glove-js": "workspace:*", "zod": "^4.3.6" },
