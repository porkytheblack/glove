{
  "name": "glove-execution",
  "version": "0.2.1",
  "description": "Mounted browser scripting and persistent sandbox capabilities for Glove agents, with Station and Kuiper backends",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/porkytheblack/glove.git",
    "directory": "packages/glove-execution"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./station": {
      "types": "./dist/station.d.ts",
      "import": "./dist/station.js"
    },
    "./kuiper": {
      "types": "./dist/kuiper.d.ts",
      "import": "./dist/kuiper.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "glove-core": "workspace:*",
    "glove-js": "workspace:*",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@kuiper-sh/sdk": "^0.2.0",
    "playwright-core": "^1.50.0",
    "station-browser-use": "^3.0.0",
    "station-client": "^3.0.0",
    "station-sandbox": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@kuiper-sh/sdk": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "station-browser-use": {
      "optional": true
    },
    "station-client": {
      "optional": true
    },
    "station-sandbox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kuiper-sh/sdk": "^0.2.0",
    "@types/node": "^25.2.3",
    "esbuild": "^0.27.3",
    "playwright-core": "^1.50.0",
    "station-browser-use": "^3.0.0",
    "station-client": "^3.0.0",
    "station-sandbox": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
