  "peerDependenciesMeta": { "station-browser-use": { "optional": true }, "station-client": { "optional": true }, "station-sandbox": { "optional": true } },
  "devDependencies": { "esbuild": "^0.27.3", "@types/node": "^25.2.3", "station-browser-use": "^3.0.0", "station-client": "^3.0.0", "station-sandbox": "^3.0.0", "tsx": "^4.19.0", "typescript": "^5.9.3" }
}
