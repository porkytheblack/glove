{
  "name": "glove-voice-s2s",
  "version": "0.3.1",
  "description": "Speech-to-speech (realtime voice model) adapters for the Glove agent framework",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "test:types": "tsc --noEmit --strict --skipLibCheck --target ES2022 --module NodeNext --moduleResolution NodeNext tests/package-consumer.mts"
  },
  "keywords": [
    "voice",
    "speech-to-speech",
    "realtime",
    "webrtc",
    "agent"
  ],
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "glove-core": "workspace:*",
    "ws": "8.19.0"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.6"
  }
}
