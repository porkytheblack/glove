{
  "name": "glove-classifier",
  "version": "0.1.0",
  "description": "Structured-decision (classifier) models for the Glove agent framework — TypeSafe's Jev, open System One models (Kev, Laya, Von, Rizzo, Decider), zero-shot label scorers, an LLM fallback, confidence-gated cascades, and agent/REPL/browser/Foundry integrations.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/porkytheblack/glove.git",
    "directory": "packages/glove-classifier"
  },
  "homepage": "https://github.com/porkytheblack/glove",
  "bugs": "https://github.com/porkytheblack/glove/issues",
  "keywords": [
    "glove",
    "classifier",
    "typesafe",
    "jev",
    "system-one",
    "llm",
    "agents",
    "scratchpad",
    "repl",
    "foundry",
    "laya",
    "kev",
    "gliclass",
    "zero-shot"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./typesafe": {
      "types": "./dist/typesafe.d.ts",
      "import": "./dist/typesafe.js"
    },
    "./systemone": {
      "types": "./dist/systemone.d.ts",
      "import": "./dist/systemone.js"
    },
    "./open-models": {
      "types": "./dist/open-models.d.ts",
      "import": "./dist/open-models.js"
    },
    "./label-scorer": {
      "types": "./dist/label-scorer.d.ts",
      "import": "./dist/label-scorer.js"
    },
    "./llm": {
      "types": "./dist/llm.d.ts",
      "import": "./dist/llm.js"
    },
    "./cascade": {
      "types": "./dist/cascade.d.ts",
      "import": "./dist/cascade.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "import": "./dist/tools.js"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.js"
    },
    "./fns": {
      "types": "./dist/fns.d.ts",
      "import": "./dist/fns.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "import": "./dist/env.js"
    },
    "./foundry": {
      "types": "./dist/foundry.d.ts",
      "import": "./dist/foundry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "glove-core": "workspace:*",
    "zod": "^4.3.6",
    "effect": "^3.19.16"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "glove-foundry": "workspace:*",
    "glove-js": "workspace:*",
    "glove-working-environment": "workspace:*",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "glove-working-environment": ">=0.7.0"
  },
  "peerDependenciesMeta": {
    "glove-working-environment": {
      "optional": true
    }
  }
}
