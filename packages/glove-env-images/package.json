{
  "name": "glove-env-images",
  "version": "0.1.0",
  "description": "Image stdlib adapter for glove-working-environment. Bridges sharp into the agent's virtual filesystem as env:images — describe an image without reading its bytes, resize, convert, crop, rotate, composite, draw text and contact-sheet. Animated GIF/WebP keep their frames and SVG rasterizes at a scale you choose. Paths in, paths out.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/porkytheblack/glove.git",
    "directory": "packages/glove-env-images"
  },
  "homepage": "https://github.com/porkytheblack/glove",
  "bugs": "https://github.com/porkytheblack/glove/issues",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  },
  "peerDependencies": {
    "glove-working-environment": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "glove-working-environment": "workspace:^",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
