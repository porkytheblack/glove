# Text turns for every layer. Without it, `pnpm dev` and `pnpm verify` use scripted models.
ANTHROPIC_API_KEY=
# Optional overrides. The interactor should stay fast; workers can be stronger.
INTERACTOR_MODEL=claude-haiku-5-5
WORKER_MODEL=claude-sonnet-5-5
# Voice calls (speech to speech).
OPENAI_API_KEY=
