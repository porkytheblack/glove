# At least one of these — pick the provider(s) you want to test.
# OpenAI Realtime (device mode, WebRTC): the key stays server-side; the
# browser only ever receives an ephemeral client secret.
OPENAI_API_KEY=

# Gemini Live (transport mode, WebSocket). DEV ONLY: the token route hands
# this key to the browser — fine on localhost, replace with ephemeral
# auth_tokens minting before deploying anywhere.
GEMINI_API_KEY=
