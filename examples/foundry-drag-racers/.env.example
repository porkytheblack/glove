# Server-only. The key is read by the Foundry agent subprocess and is never
# returned to the browser.
GEMINI_API_KEY=

# Current Gemini Live model. Override this if listGeminiLiveModels reports a
# newer model for your key.
S2S_MODEL=models/gemini-3.1-flash-live-preview
S2S_API_VERSION=v1beta

FOUNDRY_URL=http://127.0.0.1:4250
NEXT_PUBLIC_ROOM_HOST=127.0.0.1
RACER_ROOM_BASE_PORT=4700
RACER_ROOM_SLOTS=8
