{
  "name": "glove-classifier-inbox-example",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Classifier models on a labelled support inbox: Jev vs an LLM, and agents that read vs classify.",
  "scripts": {
    "bench": "tsx --env-file-if-exists=../../.env src/bench.ts",
    "agent": "tsx --env-file-if-exists=../../.env src/agent.ts",
    "repl": "tsx --env-file-if-exists=../../.env src/repl.ts",
    "typecheck": "tsc --noEmit",
    "compare": "tsx --env-file-if-exists=../../.env src/compare.ts"
  },
  "dependencies": {
    "glove-classifier": "workspace:*",
    "glove-core": "workspace:*",
    "glove-js": "workspace:*",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
