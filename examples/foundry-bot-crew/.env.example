# Model calls for every bot. Without it, `pnpm verify` and `pnpm dev` use scripted models.
ANTHROPIC_API_KEY=
# Set on Kuiper to call models through its gateway (see the README).
ANTHROPIC_BASE_URL=
CHIEF_MODEL=claude-haiku-5-5
BOT_MODEL=claude-sonnet-5-5
# The @-mention bot's X user token (OAuth 2.0, tweet.write). Without it, replies go to .data/x-outbox.jsonl.
X_BOT_TOKEN=
# Where transcripts, memory, routines and computers are kept. /data on Kuiper.
CREW_DATA_DIR=
# Locks the API and inspector once Foundry is public.
FOUNDRY_TOKEN=
FOUNDRY_DASHBOARD_PASSWORD=
# For scripts/x-webhook.ts.
X_CONSUMER_SECRET=
X_BEARER_TOKEN=
X_BOT_USER_ID=
X_BOT_HANDLE=
