# Model calls for every bot. Without it, `pnpm verify` and `pnpm dev` use scripted models.
ANTHROPIC_API_KEY=
# Set on Kuiper to call models through its gateway (see the README).
ANTHROPIC_BASE_URL=
# Every bot uses the same model.
BOT_MODEL=claude-sonnet-5-5

# Where transcripts, memory, accounts, tokens, routines and computers are kept. /data on Kuiper.
CREW_DATA_DIR=
# Locks the API and inspector once Foundry is public.
FOUNDRY_TOKEN=
FOUNDRY_DASHBOARD_PASSWORD=

# Connecting real accounts (`pnpm connect <person> gmail|linear`). Without these,
# the demo account's apps run on local sample servers.
# A Google OAuth client with the Gmail API and Gmail MCP API enabled, and
# http://127.0.0.1:53683/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# New mail: a Pub/Sub topic gmail-api-push@system.gserviceaccount.com may publish
# to, a pull subscription on it, and a service account allowed to pull.
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/gmail-crew
GOOGLE_SERVICE_ACCOUNT_JSON=
# A Linear OAuth app with the same redirect URI.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
# Override the hosted MCP servers (defaults: Google's and Linear's).
GMAIL_MCP_URL=
LINEAR_MCP_URL=
