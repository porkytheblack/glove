# ────────────────────────────────────────────────────────────── the agent
# Any provider glove-core supports. The default is anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Swap the model without touching code:
# DESK_PROVIDER=openrouter
# DESK_MODEL=anthropic/claude-sonnet-4
# OPENROUTER_API_KEY=sk-or-...

# ───────────────────────────────────────────────────── looking at the output
# Set a vision key and the agent gains `view_image`: it can rasterize a PDF,
# deck or Word file and ask a vision model what the thing actually LOOKS like
# — a table off the page, a chart with no bars, an overlapping title. Reading
# the text back cannot see any of those.
#
# Leave it unset and the verb is simply not offered. Everything else works.
#
# OPENROUTER_API_KEY above is used if it is set; VISION_API_KEY overrides it.
# VISION_API_KEY=sk-...

# Any vision-capable model. Default: google/gemini-2.5-flash — cheap, and it
# reads a rendered page accurately.
# VISION_MODEL=google/gemini-2.5-flash

# Any OpenAI-compatible chat endpoint. Default is OpenRouter's.
# VISION_BASE_URL=https://openrouter.ai/api/v1/chat/completions
