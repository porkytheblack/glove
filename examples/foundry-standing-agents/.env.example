# Model calls for the dot and the builder. Without it, `pnpm dev` uses scripted models.
ANTHROPIC_API_KEY=
# Set on Kuiper to call models through its gateway (see the README).
ANTHROPIC_BASE_URL=
DOT_MODEL=claude-sonnet-5-5
BUILDER_MODEL=claude-sonnet-5-5
# For calls with your dot: the speech-to-speech session (OpenAI Realtime).
OPENAI_API_KEY=
# The Slack app's bot token (xoxb-…, chat:write). Without it, posts go to .data/slack-outbox.jsonl.
SLACK_BOT_TOKEN=
# Which Slack workspace and app the slack-messages route accepts.
SLACK_TEAM_ID=
SLACK_APP_ID=
SLACK_BOT_USER_ID=
# Where transcripts, memory, notes, accounts, tokens and computers are kept. /data on Kuiper.
DOTS_DATA_DIR=
# Locks the API and inspector once Foundry is public. The web app sends it to Foundry.
FOUNDRY_TOKEN=
FOUNDRY_DASHBOARD_PASSWORD=

# The web app. Invite links and sessions are signed with this; production needs it.
WEB_SESSION_SECRET=
# Where people reach the web app, for invite links.
WEB_URL=http://localhost:3000
# For Slack's events (/webhooks/slack, or scripts/slack-events.ts locally).
SLACK_SIGNING_SECRET=

# Connecting a real mailbox (`pnpm connect <person> gmail`). Without these, the
# demo's mailbox runs on a local sample server.
# A Google OAuth client with the Gmail and Gmail MCP APIs enabled, marked for AI
# agent use, and http://127.0.0.1:53683/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# New mail: a Pub/Sub topic gmail-api-push@system.gserviceaccount.com may publish
# to, a pull subscription on it, and a service account allowed to pull.
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/gmail-dots
GOOGLE_SERVICE_ACCOUNT_JSON=
# Override the hosted MCP server (default: Google's).
GMAIL_MCP_URL=
