# Use raw environment values OR a private file containing one key.
OPENROUTER_API_KEY_FILE=/absolute/path/to/openrouter-key.txt
STEEL_API_KEY_FILE=/absolute/path/to/steel-key.txt
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Console 4243; resource worker 4244; Foundry inspector 4245; preview 4246.
OPERATOR_PORT=4243
SANDBOX_IMAGE=node:22-bookworm-slim
# Existing Steel profile is optional. Otherwise first start creates a blank profile.
# STEEL_PROJECT_ID=
# STEEL_PROFILE_ID=

# Must fit your Steel plan; default 15 minutes.
STEEL_SESSION_TIMEOUT_MS=900000
