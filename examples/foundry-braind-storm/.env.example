# Host-owned credentials. Foundry never acquires or refreshes these.
GEMINI_API_KEY=

# Text, image, and live voice model adapters.
BRAIND_TEXT_MODEL=gemini-3.5-flash-lite
BRAIND_TEXT_FALLBACK_MODELS=gemini-3.1-flash-lite
BRAIND_IMAGE_MODEL=gemini-3.1-flash-image
S2S_MODEL=models/gemini-3.1-flash-live-preview
S2S_API_VERSION=v1beta
BRAIND_VOICE=Kore

# Shared provider admission, failover, and retry policy. These coordinate Gemini requests
# across concurrent Foundry subprocesses without moving credentials into them.
BRAIND_GEMINI_MIN_INTERVAL_MS=8000
BRAIND_GEMINI_STALE_LEASE_MS=330000
BRAIND_MODEL_MAX_ATTEMPTS=5

# Local Foundry and dynamically allocated browser-call rooms.
FOUNDRY_URL=http://127.0.0.1:4260
BRAIND_CALL_BASE_PORT=4760
BRAIND_CALL_SLOTS=6
NEXT_PUBLIC_BRAIND_CALL_HOST=127.0.0.1
