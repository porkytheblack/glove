# Foundry never acquires or refreshes these credentials. The host supplies them.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# auto | gemini | openrouter
HERMES_TEXT_PROVIDER=auto
HERMES_TEXT_MODEL=gemini-3.5-flash-lite
HERMES_OPENROUTER_MODEL=google/gemini-2.5-flash
HERMES_IMAGE_MODEL=gemini-3.1-flash-image

# Durable single-host state. Mount this directory to persistent storage.
HERMES_DATA_DIR=.data

# local | telegram. When unset, a Telegram token selects telegram automatically.
HERMES_MESSENGER_PROVIDER=local
TELEGRAM_BOT_TOKEN=
# Optional for compatible test/proxy endpoints. Production defaults to api.telegram.org.
TELEGRAM_API_BASE_URL=
TELEGRAM_LONG_POLL_SECONDS=25

# Runtime listener. Keep localhost unless a trusted proxy or container publishes it.
FOUNDRY_HOST=127.0.0.1
FOUNDRY_PORT=4244

# Set to 1 for the deterministic, zero-network implementation used by verify.
HERMES_FORCE_DEMO=0
