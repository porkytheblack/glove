# Foundry never acquires or refreshes these credentials. The host supplies them.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# auto | gemini | openrouter
HERMES_TEXT_PROVIDER=auto
HERMES_TEXT_MODEL=gemini-3.5-flash-lite
HERMES_OPENROUTER_MODEL=google/gemini-2.5-flash
HERMES_IMAGE_MODEL=gemini-3.1-flash-image

# Set to 1 for the deterministic, zero-network implementation used by verify.
HERMES_FORCE_DEMO=0
