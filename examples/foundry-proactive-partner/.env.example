# Model calls. Without it, `pnpm verify` and `pnpm dev` use a scripted model.
ANTHROPIC_API_KEY=
# Set on Kuiper to call models through its gateway (see the README).
ANTHROPIC_BASE_URL=
PARTNER_MODEL=claude-opus-5-5
COMPUTER_MODEL=claude-sonnet-5-5
# Speech on calls.
OPENAI_API_KEY=
# Where notifications go, ntfy-style (POST the body, Title header). Without it they are only recorded.
PUSH_URL=
# Adds a classifier to the guard: passwords, codes and account numbers in words.
TYPESAFE_API_KEY=
# Where transcripts, memory, the mailbox and the ledger are kept. /data on Kuiper.
PARTNER_DATA_DIR=
# Locks the API and inspector once Foundry is public.
FOUNDRY_TOKEN=
FOUNDRY_DASHBOARD_PASSWORD=
