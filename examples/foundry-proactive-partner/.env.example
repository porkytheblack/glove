# Model calls. Without it, `pnpm verify` and `pnpm dev` use a scripted model.
ANTHROPIC_API_KEY=
# Set on Kuiper to call models through its gateway (see the README).
ANTHROPIC_BASE_URL=
PARTNER_MODEL=claude-opus-5-5
COMPUTER_MODEL=claude-sonnet-5-5
# Speech on calls.
OPENAI_API_KEY=
# Where notifications go, ntfy-style (POST the body, Title header). Without it they are only recorded.
PUSH_URL=
# Adds a classifier to the guard: passwords, codes and account numbers in words.
TYPESAFE_API_KEY=
# Where transcripts, memory, accounts, tokens and the ledger are kept. /data on Kuiper.
PARTNER_DATA_DIR=
# Locks the API and inspector once Foundry is public.
FOUNDRY_TOKEN=
FOUNDRY_DASHBOARD_PASSWORD=

# Connecting real accounts (`pnpm connect <person> gmail|calendar`). Without these,
# the demo account's apps run on local sample servers.
# A Google OAuth client with the Gmail, Gmail MCP, Calendar and Calendar MCP APIs
# enabled, marked for AI agent use, and http://127.0.0.1:53683/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# New mail: a Pub/Sub topic gmail-api-push@system.gserviceaccount.com may publish
# to, a pull subscription on it, and a service account allowed to pull.
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/gmail-partner
GOOGLE_SERVICE_ACCOUNT_JSON=
# Override the hosted MCP servers (defaults: Google's).
GMAIL_MCP_URL=
CALENDAR_MCP_URL=
