# ── The barista's model ──────────────────────────────────────────────────
# Set one key and the default fast model for that provider is used. With no
# key a scripted barista answers, which is enough to try the app and the
# voice pipeline end to end.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# Or choose exactly (any provider glove-core's createAdapter knows):
# COFFEE_MODEL_PROVIDER=anthropic
# COFFEE_MODEL=claude-haiku-5-5

# Force the scripted barista even when a key is set.
# COFFEE_DEMO=1

# ── Voice ────────────────────────────────────────────────────────────────
# Scribe v3 Live (speech to text), Scribe v3 (recordings) and the barista's
# voice. Without it the app works by text.
ELEVENLABS_API_KEY=

# NEXT_PUBLIC_SCRIBE_MODEL=scribe_v3_live
# NEXT_PUBLIC_ELEVENLABS_VOICE_ID=56bWURjYFHyYyVf490Dp

# ── Foundry ──────────────────────────────────────────────────────────────
# Where the web app finds the Foundry runtime (foundry.config.ts sets the port).
# FOUNDRY_URL=http://127.0.0.1:4310
