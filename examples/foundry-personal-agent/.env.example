# Muse's model and the Sentinel's. Without a key, `pnpm verify` and `pnpm dev` use a scripted model.
ANTHROPIC_API_KEY=
# Set on Kuiper to call models through its gateway (see the README).
ANTHROPIC_BASE_URL=
MUSE_MODEL=claude-sonnet-5-5
SENTINEL_MODEL=claude-haiku-5-5
# Where conversations, memory, accounts, tokens, logins, the log and the computer are kept. /data on Kuiper.
MUSE_DATA_DIR=
# Locks the API and inspector once Foundry is public.
FOUNDRY_TOKEN=
FOUNDRY_DASHBOARD_PASSWORD=

# WhatsApp (Meta's Cloud API). Muse's business number, a system user token,
# and for scripts/whatsapp-webhook.ts the app secret and the verify token you
# give Meta when you register the webhook. Without a token, answers go to the ledger.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0

# Connecting real accounts (`pnpm connect <person> gmail|calendar read|act`).
# Without these, the demo person's apps run on local sample servers.
# A Google OAuth client with the Gmail, Gmail MCP, Calendar and Calendar MCP APIs
# enabled, marked for AI agent use, and http://127.0.0.1:53683/callback as a redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# New mail: a Pub/Sub topic gmail-api-push@system.gserviceaccount.com may publish
# to, a pull subscription on it, and a service account allowed to pull.
GMAIL_PUBSUB_TOPIC=projects/your-project/topics/gmail
GMAIL_PUBSUB_SUBSCRIPTION=projects/your-project/subscriptions/gmail-muse
GOOGLE_SERVICE_ACCOUNT_JSON=
# Override the hosted MCP servers (defaults: Google's).
GMAIL_MCP_URL=
CALENDAR_MCP_URL=
