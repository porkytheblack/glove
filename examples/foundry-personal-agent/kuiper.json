{
  "schemaVersion": 1,
  "project": "glove-foundry-personal-agent",
  "runtime": { "entrypoint": ["/usr/bin/tini", "--", "node", "scripts/start.mjs"] },
  "ports": [{ "name": "http", "port": 3000, "public": true }],
  "env": {
    "required": ["WEB_SESSION_SECRET", "FOUNDRY_TOKEN"],
    "optional": [
      "WEB_URL", "MUSE_DATA_DIR", "MUSE_DEMO", "MUSE_MODEL", "SENTINEL_MODEL",
      "KUIPER_GATEWAY_KEY", "BROWSERS_URL", "ANTHROPIC_API_KEY", "OPENROUTER_API_KEY",
      "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "GMAIL_PUBSUB_TOPIC", "GMAIL_PUBSUB_SUBSCRIPTION",
      "GOOGLE_SERVICE_ACCOUNT_JSON", "WHATSAPP_PHONE_NUMBER_ID", "WHATSAPP_TOKEN"
    ]
  },
  "resources": {
    "request": { "cpu": 0.5, "memoryMiB": 1024 },
    "limit": { "cpu": 2, "memoryMiB": 2048 },
    "volumeGiB": 5
  },
  "health": { "tcp": true, "intervalSec": 10 }
}
